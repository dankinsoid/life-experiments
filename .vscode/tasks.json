{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Evolution: run",
      "type": "shell",
      "command": "julia",
      "args": [
        "--project=.",
        "-i",
        "notebooks/evolution.jl"
      ],
      "options": {
        "cwd": "${workspaceFolder}/julia-evolution"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Evolution: instantiate deps",
      "type": "shell",
      "command": "julia",
      "args": [
        "--project=.",
        "-e",
        "using Pkg; Pkg.instantiate()"
      ],
      "options": {
        "cwd": "${workspaceFolder}/julia-evolution"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
